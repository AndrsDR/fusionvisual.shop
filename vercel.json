{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "functions": {
        "api/**/*.js": {
            "runtime": "nodejs20.x",
            "maxDuration": 10
        } 
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/(.*)", "destination": "/" }
    ]
}
